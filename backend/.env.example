# Environment Configuration for AICookBook
# Copy this file to .env and fill in your values

# ===================
# AI Configuration (DeepSeek/OpenAI)
# ===================
AI_API_KEY=your_ai_api_key_here
AI_MODEL=deepseek-chat
AI_API_BASE_URL=https://api.deepseek.com

# Optional OpenAI compatibility
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=deepseek-chat

# ===================
# Pixabay Configuration
# ===================
PIXABAY_API_KEY=your_pixabay_api_key_here

# ===================
# PostgreSQL Configuration (Neon)
# ===================
DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Legacy local PostgreSQL (used as fallback if DATABASE_URL is not set)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=aicookbook
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password_here

# ===================
# Server Configuration
# ===================
PORT=3000
NODE_ENV=development
